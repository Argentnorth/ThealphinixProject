# Application and persistence
APP_ENV=development
FLASK_DEBUG=false
AUTO_CREATE_SCHEMA=true
SCHEDULER_ENABLED=true
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14
DATABASE_URL=sqlite:///instance/support_automation.db
ATTACHMENT_DIR=storage/attachments

# Docker Compose PostgreSQL settings. Change the placeholder before use.
POSTGRES_DB=support_automation
POSTGRES_USER=support_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_UPLOAD_BYTES=15728640

# Support identity and local-safe delivery mode
MAIL_FROM=support@example.com
MAIL_FROM_NAME=SupportPilot
MAIL_TRANSPORT=console
OUTBOX_MAX_ATTEMPTS=5
# A committed reply wakes the scheduler immediately; this is the idle fallback.
OUTBOX_SECONDS=1
# Comma-separated support addresses that must never receive automatic replies.
AUTO_ACK_SUPPORT_ADDRESSES=support@example.com
AUTO_ACKNOWLEDGEMENT=true

# Set MAIL_TRANSPORT=smtp only when these are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=20

# IMAP inbound sync is off until credentials are explicitly configured.
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# The scheduler checks for unseen mail at most every five seconds.
POLL_SECONDS=5
SLA_CHECK_SECONDS=900

# Optional, local-only classifier model and legacy review-only AI draft endpoint.
CLASSIFIER_MODEL_PATH=
LLM_ENDPOINT=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15

# Groq structured email intake and reply generation. Keep secrets only in .env;
# never paste a live key into this template, source code, or chat.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20
AI_CUSTOMER_CONFIDENCE_THRESHOLD=0.85
